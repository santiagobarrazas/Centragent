// Centragent data model.
//
// Centragent is a local-first, multi-user control plane for autonomous agents.
// The hierarchy is Project > (Conversations, Documents/assets, Agents via
// Membership, Members). Identity is NEVER self-declared: every request is bound
// to an ApiToken (MCP/programmatic) or Session (web) that resolves to a
// Principal (a User, optionally impersonating an Agent the user owns).
//
// Constraints that Prisma cannot express (CHECK constraints, partial unique
// indexes, the private-note invariant) live in prisma/sql/constraints.sql and
// are applied by `pnpm --filter @centragent/db db:setup`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PrincipalType {
  user
  agent

  @@map("principal_type")
}

enum ProjectKind {
  workspace
  agent_workspace

  @@map("project_kind")
}

enum ProjectRole {
  owner
  admin
  member
  viewer

  @@map("project_role")
}

enum MembershipStatus {
  active
  pending
  invited
  removed

  @@map("membership_status")
}

enum DocumentKind {
  project_overview
  project_asset
  conversation_summary
  agent_profile
  agent_notes

  @@map("document_kind")
}

enum EditSource {
  manual
  agent
  system
  auto_summary

  @@map("edit_source")
}

enum Visibility {
  shared
  private

  @@map("visibility")
}

enum TokenKind {
  user
  agent

  @@map("token_kind")
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired

  @@map("invite_status")
}

// ---------------------------------------------------------------------------
// Principals & credentials
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String?  @unique
  // Argon2id hash. Null = passwordless local owner (auto-paired on loopback).
  passwordHash String?  @map("password_hash")
  // Exactly one local owner row exists; created by the launcher / first run.
  isLocalOwner Boolean  @default(false) @map("is_local_owner")
  avatarColor  String?  @map("avatar_color")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedAgents      Agent[]
  apiTokens        ApiToken[]
  sessions         Session[]
  memberships      Membership[]
  createdProjects  Project[]         @relation("ProjectCreatedBy")
  sentInvites      ProjectInvite[]   @relation("InviteCreatedBy")
  authoredVersions DocumentVersion[] @relation("VersionAuthorUser")
  sentMessages     Message[]         @relation("MessageSenderUser")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Opaque per-install bearer credential. The raw token (ctg_user_… / ctg_agent_…)
// is shown once at mint; only sha256(raw) is stored. `agentId` set => the token
// impersonates that agent, and the impersonation invariant (agent.ownerId ==
// userId) is enforced both at mint and on every request.
model ApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  kind       TokenKind
  tokenHash  String    @unique @map("token_hash")
  prefix     String // display only, e.g. "ctg_user_7Fa2…"
  userId     String    @map("user_id") @db.Uuid
  agentId    String?   @map("agent_id") @db.Uuid
  label      String // e.g. "claude-code @ /repo"
  scopes     String[]  @default([])
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Agent-scoped tokens are cascade-deleted with their agent so a deleted
  // agent's CI token cannot silently survive as a user-only token.
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([agentId])
  @@map("api_tokens")
}

// ---------------------------------------------------------------------------
// Hierarchy: Project > Conversations / Documents / Agents (via Membership)
// ---------------------------------------------------------------------------

model Project {
  id          String      @id @default(uuid()) @db.Uuid
  slug        String      @unique
  name        String
  kind        ProjectKind @default(workspace)
  summary     String? // short human description (the overview doc holds the long .md)
  createdById String      @map("created_by_id") @db.Uuid
  archivedAt  DateTime?   @map("archived_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  createdBy      User            @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  conversations  Conversation[]
  documents      Document[]
  memberships    Membership[]
  invites        ProjectInvite[]
  qdrantMemory   QdrantMemory[]
  // When kind = agent_workspace, the agent this project belongs to.
  workspaceAgent Agent?          @relation("AgentWorkspaceProject")

  @@index([slug])
  @@index([createdById])
  @@map("projects")
}

model ProjectInvite {
  id           String       @id @default(uuid()) @db.Uuid
  projectId    String       @map("project_id") @db.Uuid
  email        String?
  codeHash     String       @unique @map("code_hash")
  prefix       String
  role         ProjectRole  @default(member)
  status       InviteStatus @default(pending)
  createdById  String       @map("created_by_id") @db.Uuid
  acceptedById String?      @map("accepted_by_id") @db.Uuid
  expiresAt    DateTime     @map("expires_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("InviteCreatedBy", fields: [createdById], references: [id])

  @@index([projectId, status])
  @@map("project_invites")
}

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  title         String
  // Race-free per-conversation message sequence allocator (UPDATE ... RETURNING).
  messageSeq    Int       @default(0) @map("message_seq")
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastMessageAt DateTime? @map("last_message_at")
  archivedAt    DateTime? @map("archived_at")

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  messages     Message[]
  documents    Document[]
  activities   AgentActivity[]
  agentEvents  AgentEvent[]
  presences    AgentPresence[]
  joinRequests JoinRequest[]
  qdrantMemory QdrantMemory[]

  @@index([projectId, lastMessageAt])
  @@map("conversations")
}

model Agent {
  id                 String    @id @default(uuid()) @db.Uuid
  ownerId            String    @map("owner_id") @db.Uuid
  // Each agent gets a private agent_workspace Project (req 7), auto-created.
  workspaceProjectId String?   @unique @map("workspace_project_id") @db.Uuid
  name               String
  handle             String    @unique
  provider           String
  description        String? // short blurb; the agent_profile doc holds the long .md
  // Per-agent toggle: may the agent edit its own private notes? (req 2)
  notesAgentEditable Boolean   @default(false) @map("notes_agent_editable")
  clientInstanceId   String?   @map("client_instance_id")
  config             Json      @default("{}")
  lastSeenAt         DateTime? @map("last_seen_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  owner            User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspaceProject Project?             @relation("AgentWorkspaceProject", fields: [workspaceProjectId], references: [id], onDelete: SetNull)
  apiTokens        ApiToken[]
  memberships      Membership[]
  documents        Document[]
  activities       AgentActivity[]
  presences        AgentPresence[]
  eventDeliveries  AgentEventDelivery[]
  targetedEvents   AgentEvent[]         @relation("AgentEventTargetAgent")
  joinRequests     JoinRequest[]
  sentMessages     Message[]            @relation("MessageSenderAgent")
  qdrantMemory     QdrantMemory[]

  @@index([ownerId])
  @@index([provider, clientInstanceId, name])
  @@map("agents")
}

// Unified ACL row for any principal (user OR agent) at a project and,
// optionally, a specific conversation. Subsumes the old ConversationAgent.
// A row with conversationId = null is a project-level membership; a row with
// conversationId set grants conversation participation. For agents in a
// conversation this row also anchors presence/activity/inbox/messages.
model Membership {
  id              String           @id @default(uuid()) @db.Uuid
  principalType   PrincipalType    @map("principal_type")
  userId          String?          @map("user_id") @db.Uuid
  agentId         String?          @map("agent_id") @db.Uuid
  projectId       String           @map("project_id") @db.Uuid
  conversationId  String?          @map("conversation_id") @db.Uuid
  role            ProjectRole      @default(member)
  status          MembershipStatus @default(active)
  // Self-declared participation role label (coder/reviewer/...). Display only.
  participantRole String?          @map("participant_role")
  joinedAt        DateTime?        @map("joined_at")
  leftAt          DateTime?        @map("left_at")
  metadata        Json             @default("{}")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  presence        AgentPresence?
  activities      AgentActivity[]
  eventDeliveries AgentEventDelivery[]
  targetedEvents  AgentEvent[]         @relation("AgentEventTargetMembership")
  messages        Message[]

  @@index([projectId, role])
  @@index([conversationId, status])
  @@index([agentId])
  @@index([userId])
  // Real uniqueness is enforced by partial unique indexes in constraints.sql
  // (Postgres treats NULLs as distinct, so a plain @@unique would not hold).
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Living documents (.md) — continuously updated, versioned
// ---------------------------------------------------------------------------

model Document {
  id               String       @id @default(uuid()) @db.Uuid
  kind             DocumentKind
  projectId        String?      @map("project_id") @db.Uuid
  conversationId   String?      @map("conversation_id") @db.Uuid
  agentId          String?      @map("agent_id") @db.Uuid
  title            String
  slug             String? // for project assets
  // May a participating agent edit this doc at all?
  agentEditable    Boolean      @default(true) @map("agent_editable")
  // agent_notes => true (owner + owning agent only).
  isPrivate        Boolean      @default(false) @map("is_private")
  visibility       Visibility   @default(shared)
  // Fast-read snapshot of the latest version's content.
  currentContent   String       @default("") @map("current_content")
  // Race-free per-document version allocator (UPDATE ... RETURNING).
  versionSeq       Int          @default(0) @map("version_seq")
  currentVersionId String?      @unique @map("current_version_id") @db.Uuid
  // Link to this doc's point in the vector index, when indexed.
  pointId          String?      @map("point_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  project        Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation   Conversation?     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent          Agent?            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  versions       DocumentVersion[] @relation("DocVersions")
  currentVersion DocumentVersion?  @relation("DocCurrent", fields: [currentVersionId], references: [id])

  @@index([projectId, kind])
  @@index([conversationId, kind])
  @@index([agentId, kind])
  @@map("documents")
}

model DocumentVersion {
  id            String        @id @default(uuid()) @db.Uuid
  documentId    String        @map("document_id") @db.Uuid
  versionNumber Int           @map("version_number")
  content       String
  editSource    EditSource    @map("edit_source")
  authorType    PrincipalType @map("author_type")
  authorUserId  String?       @map("author_user_id") @db.Uuid
  authorAgentId String?       @map("author_agent_id") @db.Uuid
  changeSummary String?       @map("change_summary")
  createdAt     DateTime      @default(now()) @map("created_at")

  document   Document  @relation("DocVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentFor Document? @relation("DocCurrent")
  authorUser User?     @relation("VersionAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@unique([documentId, versionNumber])
  @@index([documentId, createdAt])
  @@map("document_versions")
}

// ---------------------------------------------------------------------------
// Messages
// ---------------------------------------------------------------------------

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderType     String   @map("sender_type") // user | agent | system | tool
  senderUserId   String?  @map("sender_user_id") @db.Uuid
  senderAgentId  String?  @map("sender_agent_id") @db.Uuid
  // The participating membership (for agents and member users).
  membershipId   String?  @map("membership_id") @db.Uuid
  role           String // user | assistant | system | tool
  status         String   @default("complete")
  content        String
  sequenceNumber Int      @map("sequence_number")
  createdAt      DateTime @default(now()) @map("created_at")
  metadata       Json     @default("{}")

  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  membership   Membership?    @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  senderUser   User?          @relation("MessageSenderUser", fields: [senderUserId], references: [id], onDelete: SetNull)
  senderAgent  Agent?         @relation("MessageSenderAgent", fields: [senderAgentId], references: [id], onDelete: SetNull)
  agentEvents  AgentEvent[]
  qdrantMemory QdrantMemory[]

  @@unique([conversationId, sequenceNumber])
  @@index([conversationId, createdAt])
  @@index([membershipId])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Agent presence / activity / orchestration inbox (salvaged, re-anchored on
// Membership so an agent can work in multiple conversations independently).
// ---------------------------------------------------------------------------

model AgentPresence {
  membershipId   String   @id @map("membership_id") @db.Uuid
  agentId        String   @map("agent_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  status         String // available | working | listening | needs_attention | offline
  statusMessage  String?  @map("status_message")
  activityTitle  String?  @map("activity_title")
  metadata       Json     @default("{}")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([conversationId, status])
  @@map("agent_presence")
}

model AgentActivity {
  id             String    @id @default(uuid()) @db.Uuid
  agentId        String    @map("agent_id") @db.Uuid
  conversationId String?   @map("conversation_id") @db.Uuid
  membershipId   String?   @map("membership_id") @db.Uuid
  title          String
  status         String // working | completed | failed | cancelled
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  membership   Membership?   @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([agentId, status])
  @@index([conversationId])
  @@index([membershipId])
  @@map("agent_activities")
}

model AgentEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  type               String // mention | message | task_assigned | handoff_requested | system
  conversationId     String?  @map("conversation_id") @db.Uuid
  messageId          String?  @map("message_id") @db.Uuid
  actorType          String?  @map("actor_type")
  actorId            String?  @map("actor_id") @db.Uuid
  targetAgentId      String?  @map("target_agent_id") @db.Uuid
  targetMembershipId String?  @map("target_membership_id") @db.Uuid
  title              String?
  content            String?
  data               Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at")

  conversation     Conversation?        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message          Message?             @relation(fields: [messageId], references: [id], onDelete: SetNull)
  targetAgent      Agent?               @relation("AgentEventTargetAgent", fields: [targetAgentId], references: [id], onDelete: SetNull)
  targetMembership Membership?          @relation("AgentEventTargetMembership", fields: [targetMembershipId], references: [id], onDelete: SetNull)
  deliveries       AgentEventDelivery[]

  @@index([conversationId, createdAt])
  @@index([messageId])
  @@index([targetAgentId, createdAt])
  @@index([type, createdAt])
  @@map("agent_events")
}

model AgentEventDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  agentId        String    @map("agent_id") @db.Uuid
  membershipId   String?   @map("membership_id") @db.Uuid
  status         String // pending | delivered | acknowledged
  deliveredAt    DateTime? @map("delivered_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  event      AgentEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  agent      Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@unique([eventId, agentId, membershipId])
  @@index([agentId, status, createdAt])
  @@index([membershipId, status])
  @@map("agent_event_deliveries")
}

model JoinRequest {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  agentId        String    @map("agent_id") @db.Uuid
  requestedRole  String    @map("requested_role")
  status         String // pending | accepted | rejected | cancelled | timed_out
  reason         String?
  expiresAt      DateTime  @map("expires_at")
  respondedAt    DateTime? @map("responded_at")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@index([agentId])
  @@index([status, expiresAt])
  @@map("join_requests")
}

// ---------------------------------------------------------------------------
// Vector memory mirror (Qdrant is the index; Postgres is the truth).
// ---------------------------------------------------------------------------

model QdrantMemory {
  pointId        String     @id @map("point_id")
  projectId      String?    @map("project_id") @db.Uuid
  conversationId String?    @map("conversation_id") @db.Uuid
  agentId        String?    @map("agent_id") @db.Uuid
  membershipId   String?    @map("membership_id") @db.Uuid
  messageId      String?    @map("message_id") @db.Uuid
  documentId     String?    @map("document_id") @db.Uuid
  scopeType      String     @map("scope_type") // message | conversation_summary | agent_note | project_asset | fact
  scopeId        String?    @map("scope_id") @db.Uuid
  kind           String     @default("episodic") // episodic | summary | fact | note
  visibility     Visibility @default(shared)
  ownerAgentId   String?    @map("owner_agent_id") @db.Uuid // set iff visibility = private
  importance     Float?
  content        String
  metadata       Json       @default("{}")
  // Temporal fact bookkeeping (mem0-style supersession; written later).
  validFrom      DateTime?  @map("valid_from")
  validTo        DateTime?  @map("valid_to")
  supersededById String?    @map("superseded_by_id")
  createdAt      DateTime   @default(now()) @map("created_at")

  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([conversationId])
  @@index([agentId])
  @@index([messageId])
  @@index([scopeType])
  @@map("qdrant_memory")
}
